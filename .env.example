# URL privada del servidor NestJS, incluyendo /api/v1.
BACKEND_API_URL=https://blog-backend-nest-542aed7d1eb3.herokuapp.com/api/v1
# Opcional en local; configurar el origen público exacto en producción.
# APP_ORIGIN=https://blog.example.com

# See ../blog-backend/docs/SEGURIDAD_Y_PROXY.md before enabling forwarding.
BFF_CLIENT_IP_SOURCE=none
# Server-only shared secret; never NEXT_PUBLIC_ and never the JWT secret.
# BFF_IDENTITY_SECRET=
